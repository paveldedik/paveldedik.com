# Copy to .env (gitignored) and `source .env` before any terraform or wrangler
# command. ONE file for the whole zone — every module under terraform/ reads it.
#
# Every value is the same as in ~/Projects/pavlanna.cz/.env (same Cloudflare
# account, one API token covering both zones) except TF_VAR_zone_id.

# Cloudflare API token — used by the Terraform provider and by `wrangler`.
# Shared with pavlanna.cz; the same value is the CLOUDFLARE_API_TOKEN GitHub secret.
# Scopes: Account -> Cloudflare Pages: Edit
#         Zone    -> DNS: Edit             on paveldedik.com
#         Zone    -> Single Redirect: Edit on paveldedik.com
export CLOUDFLARE_API_TOKEN=

# Cloudflare account ID — used by wrangler and as the R2 endpoint host in
# backend.hcl. Dashboard -> any domain -> right sidebar "Account ID".
export CLOUDFLARE_ACCOUNT_ID=

# Same account ID, handed to Terraform as a variable.
export TF_VAR_account_id="$CLOUDFLARE_ACCOUNT_ID"

# paveldedik.com zone ID — zone overview page -> right sidebar. Exists once the
# domain has been added to Cloudflare.
export TF_VAR_zone_id=

# R2 S3 credentials for the Terraform state backend — a distinct HMAC keypair,
# NOT the API token above. Dashboard -> R2 -> Manage R2 API Tokens. Must be
# allowed to read and write the paveldedik-tfstate bucket.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
