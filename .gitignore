# Repo-root .gitignore — the zone's shared concerns. The site under root/ has
# its own root/.gitignore for Node noise.

# Secrets & local config — never commit. Shared by every Terraform module.
.env
.env.production
backend.hcl
*.auto.tfvars
terraform.tfvars

# Terraform working dirs & any local state cache (real state lives in R2).
# NOTE: **/.terraform.lock.hcl IS committed (pins exact provider versions).
**/.terraform/
*.tfstate
*.tfstate.*
crash.log

# Editor & OS
.DS_Store
.idea/
extensions.json
launch.json

# Wrangler cache from a manual `wrangler pages deploy`.
.wrangler/
